{
  "name": "[GCP] Java Developer",
  "build": { "dockerfile": "Dockerfile" },
  "runArgs": [
    "--name=pjf-dev"
  ],
  "remoteUser": "dev",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "false",
      "dockerDashComposeVersion": "none"
    }
  },
  "remoteEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },
  "postStartCommand": "ln -sfn ~/.local/state/nix/profiles/profile ~/.nix-profile",
  "containerEnv": {
    "CLOUDSDK_CORE_PROJECT": "psi-de-0-dev-cft-pjfc",
    "GOOGLE_CLOUD_QUOTA_PROJECT": "psi-de-0-dev-cft-pjfc",
    "GOOGLE_CLOUD_PROJECT": "psi-de-0-dev-cft-pjfc",
    "USER": "dev",
    "XDG_CONFIG_HOME": "/home/dev/.config",
    "XDG_DATA_HOME": "/home/dev/.local/share",
    "XDG_STATE_HOME": "/home/dev/.local/state",
    "NIX_PROFILES": "/home/dev/.local/state/nix/profiles/profile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "asciidoctor.asciidoctor-vscode",
        "EditorConfig.EditorConfig",
        "github.vscode-github-actions",
        "GitLab.gitlab-workflow",
        "google.gemini-cli-vscode-ide-companion",
        "Google.google-antigravity",
        "MermaidChart.vscode-mermaid-chart",
        "ms-azuretools.vscode-containers",
        "streetsidesoftware.code-spell-checker",
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "mounts": [
    "source=pjf-dev-projects,target=/home/dev/projects,type=volume",
    "source=pjf-dev-local,target=/home/dev/.local,type=volume",
    "source=pjf-dev-config,target=/home/dev/.config,type=volume",
    "source=pjf-dev-ssh,target=/home/dev/.ssh,type=volume",
    "source=nix-store,target=/nix,type=volume",
    "source=java-developer-bash-history,target=/commandhistory,type=volume",
    "source=pjf-dev-gcloud,target=/home/dev/.config/gcloud,type=volume",
    "source=pjf-dev-kube,target=/home/dev/.kube,type=volume",
    "source=pjf-dev-m2-repository,target=/home/dev/.m2/repository,type=volume",
    "source=/mnt/c/Users/${localEnv:USERNAME}/.m2/settings.xml,target=/home/dev/.m2/settings.xml,type=bind,consistency=cached",
    "source=/mnt/c/Users/${localEnv:USERNAME}/.npmrc,target=/home/dev/.npmrc,type=bind,consistency=cached"
  ],
  "postCreateCommand": "ln -sfn /home/dev/projects /home/dev/IdeaProjects && echo 'export PATH=\"$HOME/.local/state/nix/profiles/profile/bin:$PATH\"' >> /home/dev/.profile && echo 'export PATH=\"$HOME/.local/state/nix/profiles/profile/bin:$PATH\"' >> /home/dev/.bashrc"
}
